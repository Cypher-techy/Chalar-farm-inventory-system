    "db:backup": "tsx src/db/backup.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "jose": "^6.0.10",
    "lucide-react": "^0.475.0",
    "next": "^16.4.3",
    "pg": "^8.13.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "postcss": "^8.5.2",
