# ============================================================================
# CHALAR FARMS INVENTORY & FARM MANAGEMENT PORTAL — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in real values before deployment.
# NEVER commit .env or .env.local containing real credentials to Git.
# ============================================================================

# !! LOCAL DEVELOPMENT VALUES — do not paste this file into Vercel. See docs/DEPLOYMENT.md §3a.
# !! On Vercel set only: ENABLE_DEMO_SEED=false, INITIAL_ADMIN_* and (unless the Supabase
# !! integration is connected) DATABASE_URL.

# 1. APPLICATION ENVIRONMENT
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Chalar Farms ERP & Inventory Portal"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ENABLE_DEMO_SEED="true"

# First Super Administrator for production / configuration-only databases.
# Used ONLY when no active Super Administrator exists; ignored afterwards.
# Password: 12+ chars mixing three of lowercase/uppercase/digits/symbols.
# Remove INITIAL_ADMIN_PASSWORD after the first sign-in and rotate it in the portal.
# INITIAL_ADMIN_EMAIL="admin@your-domain.example"
# INITIAL_ADMIN_PASSWORD="replace-with-a-strong-unique-password"
# INITIAL_ADMIN_NAME="System Administrator"

# 2. DATABASE CONFIGURATION (PostgreSQL / Drizzle ORM)
# Production / Vercel — a PostgreSQL URL is REQUIRED there (the embedded database cannot run on Vercel).
# If the Vercel ↔ Supabase integration is connected it provides POSTGRES_URL, which is used
# automatically (lookup order: DATABASE_URL, POSTGRES_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING).
# Otherwise set DATABASE_URL:
# Supabase: Dashboard → Connect → "Transaction pooler" (port 6543). Percent-encode
# special characters in the password (@ → %40, # → %23, / → %2F, ? → %3F, % → %25).
# No ?sslmode is needed: remote connections are always encrypted.
# DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-1-<region>.pooler.supabase.com:6543/postgres"
# Other managed PostgreSQL (Neon / RDS / self-hosted):
# DATABASE_URL="postgresql://db_user:db_password@db_host:5432/chalar_farms_erp"
#
# Optional TLS / pool tuning:
#   DATABASE_SSL       disable | require (encrypt, default for remote hosts) | verify-full
#   DATABASE_CA_CERT   provider CA certificate (PEM; "\n" escapes allowed) → enables full verification
#   DATABASE_POOL_MAX  connections per server instance (default 3 on Vercel, 10 elsewhere)
#
# Local development — embedded PostgreSQL (PGlite):
DATABASE_URL="pglite://./.data/chalar-pg"

# 3. AUTHENTICATION & SECURITY
# Reserved — sessions are random tokens stored hashed, so this is not currently read.
# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-at-least-32-bytes-cryptographic-random-secret"
SESSION_TTL_HOURS="12"
AUTH_MAX_LOGIN_ATTEMPTS="5"
AUTH_LOCKOUT_MINUTES="15"

# 4. PRIVATE DOCUMENT & ATTACHMENT STORAGE
# Local private directory outside public web root, or S3-compatible private bucket
PRIVATE_STORAGE_DRIVER="local"
PRIVATE_STORAGE_PATH="./.storage/private-documents"
MAX_UPLOAD_SIZE_BYTES="10485760"
SIGNED_URL_TTL_SECONDS="300"
S3_BUCKET_NAME=""
S3_REGION="af-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# 5. OPTIONAL INTEGRATIONS (Safe sandbox mode until credentials are provided)
# Safaricom Daraja M-Pesa B2B / B2C / C2B API
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_SECRET=""

# Transactional Email (SMTP / Resend)
EMAIL_PROVIDER="disabled"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="erp-notifications@chalarfarms.com"
